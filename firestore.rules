rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // These rules protect requests made by the web app. Firebase Admin SDK
    // calls from Cloud Functions bypass Firestore Security Rules.
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function kioskEmail() {
      // Keep this value aligned with VITE_KIOSK_AUTH_EMAIL.
      return 'kiosk@myapp.internal';
    }

    function coachEmails() {
      // Replace this list with the Firebase Authentication emails for coaches.
      // Keep it aligned with functions/.env COACH_EMAILS if Functions are used.
      return [
        'coach@example.com',
        'coach@test.com'
      ];
    }

    function isKiosk() {
      return signedIn() && request.auth.token.email == kioskEmail();
    }

    function isStudentAuth() {
      return signedIn()
        && !isKiosk()
        && request.auth.token.email.matches('.*@myapp\\.internal$');
    }

    function isCoach() {
      return signedIn() && request.auth.token.email in coachEmails();
    }

    function isRecognizedUser() {
      return isCoach() || isKiosk() || isStudentAuth();
    }

    function studentAuthId() {
      return request.auth.token.email.split('@')[0];
    }

    function ownsStudent(data) {
      return isStudentAuth() && data.studentId == studentAuthId();
    }

    function ownsTimeLogByStudentId(data) {
      return isStudentAuth() && data.studentId == studentAuthId();
    }

    function ownsStudentDocument(studentDocId) {
      return isStudentAuth()
        && studentDocId is string
        && get(/databases/$(database)/documents/students/$(studentDocId)).data.studentId == studentAuthId();
    }

    function ownsStudentIdentity(data) {
      return ownsTimeLogByStudentId(data)
        && ownsStudentDocument(data.studentDocId);
    }

    function ownsTimeLog(data) {
      return ownsTimeLogByStudentId(data)
        || ownsStudentDocument(data.studentDocId);
    }

    function ownsExtraTimeRequest(data) {
      return (
        isStudentAuth()
        && data.studentId == studentAuthId()
      ) || ownsStudentDocument(data.studentDocId);
    }

    function onlySessionFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'signedIn',
        'signedInAt',
        'currentTask',
        'currentTaskId',
        'activeTimeLogId'
      ]);
    }

    function validStudentSessionUpdate() {
      return onlySessionFieldsChanged()
        && (
          request.resource.data.signedIn == true
          || request.resource.data.signedIn == false
          || request.resource.data.signedIn == null
        );
    }

    function validActiveTimeLogCreate() {
      return request.resource.data.keys().hasAll([
        'studentDocId',
        'studentId',
        'studentName',
        'taskId',
        'taskName',
        'signInAt',
        'signOutAt',
        'signInNotes',
        'signOutNotes',
        'status',
        'durationMinutes',
        'createdAt',
        'updatedAt'
      ])
        && request.resource.data.status == 'active'
        && request.resource.data.signInAt is timestamp
        && request.resource.data.signOutAt == null
        && request.resource.data.signOutNotes == null
        && request.resource.data.durationMinutes == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validTimeLogCheckoutUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'signOutAt',
        'signOutNotes',
        'status',
        'durationMinutes',
        'updatedAt'
      ])
        && resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.signOutAt is timestamp
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes >= 0
        && request.resource.data.updatedAt == request.time;
    }

    // Student profiles also contain the live fields used by check-in screens.
    match /students/{studentId} {
      allow get, list: if isCoach() || isKiosk() || ownsStudent(resource.data);
      allow create, delete: if isCoach();
      allow update: if isCoach()
        || ((isKiosk() || ownsStudent(resource.data)) && validStudentSessionUpdate());
    }

    match /tasks/{taskId} {
      allow get, list: if isRecognizedUser();
      allow create, update, delete: if isCoach();
    }

    match /schedules/{scheduleId} {
      allow get, list: if isRecognizedUser();
      allow create, update, delete: if isCoach();
    }

    // Time logs are the historical source used for reports and analytics.
    match /timeLogs/{timeLogId} {
      allow get: if isCoach() || isKiosk() || ownsTimeLog(resource.data);
      // Student timeline queries use the stable studentDocId so logs created
      // under a previous Student ID remain readable. Compatibility queries can
      // also use previous IDs when each matching log points to that profile.
      allow list: if isCoach() || isKiosk() || ownsTimeLog(resource.data);
      allow create: if isCoach()
        || ((isKiosk() || ownsStudentIdentity(request.resource.data)) && validActiveTimeLogCreate());
      allow update: if isCoach()
        || ((isKiosk() || ownsTimeLog(resource.data)) && validTimeLogCheckoutUpdate());
      allow delete: if isCoach();
    }

    // Students can submit requests; only coaches can approve, deny, or delete.
    match /extraTimeRequests/{requestId} {
      allow get, list: if isCoach()
        || isKiosk()
        || ownsExtraTimeRequest(resource.data);
      allow create: if (
          isKiosk()
          || ownsStudentIdentity(request.resource.data)
        )
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0
        && request.resource.data.reason is string
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
